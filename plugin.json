{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "mergecomplete",
  "version": "1.0.1",
  "description": "Ask your agent for a review of the work it just did: what changed, what's risky, and a link to read it. Made on your own machine, on the Claude plan you already pay for.",
  "author": {
    "name": "mergecomplete",
    "url": "https://mergecomplete.com"
  },
  "homepage": "https://docs.mergecomplete.com",
  "repository": "https://github.com/mergecomplete/plugin",
  "license": "MIT",
  "keywords": [
    "code-review",
    "review",
    "pull-request",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "mergecomplete",
        "shortDescription": "Review what your agent changed",
        "longDescription": "Ask your agent for a review of the work it just did: what changed, what's risky, and a link to read it. Made on your own machine, on the Claude plan you already pay for.",
        "developerName": "mergecomplete",
        "category": "Coding",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://mergecomplete.com",
        "defaultPrompt": [
          "Review what you just changed"
        ],
        "brandColor": "#3fb3a6",
        "composerIcon": "./assets/icon-256.png",
        "logo": "./assets/icon-512.png",
        "logoDark": "./assets/icon-dark-512.png"
      }
    }
  }
}
